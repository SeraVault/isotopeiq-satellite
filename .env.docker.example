# ─────────────────────────────────────────────────────────────────────────────
# IsotopeIQ Satellite — Docker Environment Template
# Copy this file to .env and fill in the values before running deploy.sh
# ─────────────────────────────────────────────────────────────────────────────

# ── Required — generate before deploying ──────────────────────────────────────

# Django secret key (generates tokens, CSRF, sessions — must be long and random)
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME

# Fernet key for encrypting stored credentials (passwords, SSH keys, API tokens)
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: changing this after credentials are stored makes them unreadable — back it up!
FIELD_ENCRYPTION_KEY=CHANGE_ME

# PostgreSQL password
DB_PASSWORD=CHANGE_ME

# ── Default admin user (created automatically on first boot if set) ───────────

# Leave DJANGO_SUPERUSER_PASSWORD blank to skip auto-creation and run
# 'manage.py createsuperuser' manually instead.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@localhost
DJANGO_SUPERUSER_PASSWORD=

# Comma-separated list of hostnames or IPs the server is reachable at
# Use * to allow all (only acceptable on an isolated network)
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Domain / TLS ──────────────────────────────────────────────────────────────

# Domain name or IP used in the nginx self-signed certificate CN/SAN
# To use your own certificate instead, mount it in docker-compose.yml
DOMAIN=localhost

# URL that managed devices can reach when using Push mode
# Must be a routable address — not localhost — if devices are on a different host
SATELLITE_URL=https://localhost

# Host directories for persistent data (relative or absolute paths)
# Relative paths are resolved from the directory containing docker-compose.yml
DATA_POSTGRES=./data/postgres
DATA_REDIS=./data/redis
DATA_STATICFILES=./data/staticfiles
DATA_TLS=./data/tls

# ── Database ──────────────────────────────────────────────────────────────────

DB_NAME=isotopeiq
DB_USER=isotopeiq
# DB_HOST and DB_PORT are set by docker-compose — do not change here

# ── Notifications (optional — configure at runtime via System Settings) ───────

SYSLOG_HOST=
SYSLOG_PORT=514
SYSLOG_FACILITY=local0

# ── LDAP (optional — can also be configured at runtime via System Settings) ───

LDAP_SERVER_URI=ldap://your-ldap-server:389
LDAP_BIND_DN=cn=readonly,dc=example,dc=com
LDAP_BIND_PASSWORD=
LDAP_START_TLS=False
LDAP_USER_SEARCH_BASE=ou=users,dc=example,dc=com
LDAP_USER_SEARCH_FILTER=(uid=%(user)s)
LDAP_GROUP_SEARCH_BASE=ou=groups,dc=example,dc=com
LDAP_ATTR_FIRST_NAME=givenName
LDAP_ATTR_LAST_NAME=sn
LDAP_ATTR_EMAIL=mail
LDAP_SUPERUSER_GROUP=cn=admins,ou=groups,dc=example,dc=com
LDAP_STAFF_GROUP=cn=staff,ou=groups,dc=example,dc=com

# ── SAML 2.0 (optional) ───────────────────────────────────────────────────────

SAML_SP_ENTITY_ID=https://your-app.example.com/saml2/metadata/
SAML_ACS_URL=https://your-app.example.com/saml2/acs/
SAML_SLS_URL=https://your-app.example.com/saml2/ls/
SAML_IDP_METADATA_URL=
SAML_IDP_METADATA_FILE=
SAML_SP_KEY_FILE=
SAML_SP_CERT_FILE=
