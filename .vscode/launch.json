{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: Local",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": ["runserver", "0.0.0.0:8000"],
      "cwd": "${workspaceFolder}/backend",
      "django": true,
      "justMyCode": true,
      "python": "${workspaceFolder}/.venv/bin/python",
      "preLaunchTask": "Start Celery",
      "postDebugTask": "Stop All"
    },
    {
      "name": "Vue: Frontend (Vite)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/frontend/node_modules/.bin/vite",
      "args": ["--host"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "postDebugTask": "Stop: Vite"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: Django + Vue",
      "configurations": ["Django: Local", "Vue: Frontend (Vite)"],
      "stopAll": true
    }
  ]
}
